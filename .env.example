# NextAuth
NEXTAUTH_SECRET=your-random-secret-here
NEXTAUTH_URL=https://goldenweb.uz

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin — vergul bilan ajratilgan email(lar)
ADMIN_EMAILS=sizning@email.com

# Parol tiklash emaili (Resend)
RESEND_API_KEY=
EMAIL_FROM=GOLDENWEB.UZ <onboarding@resend.dev>

# --- GoldenWeb NFT (BNB Smart Chain) ---
# Deploy qilingan ERC-721 kontrakt manzili
NEXT_PUBLIC_GOLDENWEB_NFT_CONTRACT=
# BSC USDT (default: Binance-Peg USDT, 18 decimals)
NEXT_PUBLIC_GOLDENWEB_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
# 56 = BSC mainnet
NEXT_PUBLIC_GOLDENWEB_CHAIN_ID=56
NEXT_PUBLIC_GOLDENWEB_CHAIN_NAME=BNB Smart Chain
NEXT_PUBLIC_GOLDENWEB_RPC_URL=https://bsc-dataseed.binance.org
